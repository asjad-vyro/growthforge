# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# App runtime: TRANSACTION pooler (port 6543). postgres.js runs with prepare:false.
DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:***@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# DDL only (drizzle-kit push/migrate, scripts/apply-rls.mjs): SESSION pooler (port 5432).
MIGRATE_DATABASE_URL=postgres://postgres.YOUR-PROJECT-REF:***@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# --- Apify (apify.com → Settings → Integrations) ---
APIFY_TOKEN=
# Any random string; embedded in webhook URLs so only Apify can hit them
APIFY_WEBHOOK_SECRET=

# --- OpenRouter (openrouter.ai/keys) — ALL LLM calls ---
OPENROUTER_API_KEY=

# --- ImagineArt MCP (github.com/Vyro-ai/imagine-mcp) — ALL media generation ---
# Streamable HTTP endpoint of a running imagine-mcp server (server root, e.g. https://.../).
IMAGINE_MCP_URL=
# Bearer token from a one-time OAuth login against that server (e.g. via
# `npx @modelcontextprotocol/inspector`) under an ImagineArt org with an active subscription.
# There is no service-account bypass — this is a real user session token; re-issue by hand if it expires.
IMAGINE_MCP_ACCESS_TOKEN=
# Org to generate into — resolved once via the select_organization tool, then hardcoded here.
IMAGINE_MCP_ORG_ID=
# Optional folder (from select_folder) to place generations in; omit to use the workspace root.
IMAGINE_MCP_FOLDER_ID=

# --- App ---
# Public base URL (webhooks point here). Locally: your tunnel URL.
APP_URL=http://localhost:3000
# Any random string; protects /api/jobs/tick (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Local dev only — skips Supabase login entirely (fixed dev user/workspace). Leave unset
# everywhere else; proxy.ts and requireUser() both gate on this being exactly "true".
DEV_SKIP_AUTH=
